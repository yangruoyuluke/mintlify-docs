{
  "$schema": "https://mintlify.com/docs.json",
  "name": "MarsMindDocuments",
  "theme": "mint",
  "colors": {
    "primary": "#0D47A1",
    "light": "#ECEFF1",
    "dark": "#212121"
  },

  "navbar": {
    "primary": {
      "type":  "button",
      "label": "Dashboard",
      "href":  "https://app.marsmind.co",

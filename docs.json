{
  "$schema": "https://mintlify.com/docs.json",
  
  "name": "MarsMindDocuments",
  
  "theme": "mint",
  
  "colors": {
    "primary": "#0D47A1",
    "light": "#ECEFF1",
    "dark": "#212121"
  },

  "logo": {
    "light": "logo-light.png",
    "dark": "logo-dark.png"
  },
  
  "favicon": {
    "light": "public/favicon.svg",
    "dark": "public/favicon-dark.svg"
  },
    
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://lufitglobalselling.com:8888/#/index",
      "target": "_blank"
    }
  },

  "topbarLinks": [],

  "tabs": [
    {
      "name": "English",
      "url": "introduction"
    },
    {
      "name": "日本語", 
      "url": "jp/introduction"
    }
  ],

  "navigation": {
    "groups": [
      {
        "group": "Getting Started",
        "pages": [
          "introduction",
          "quickstart"
        ]
      },
      {
        "group": "Product",
        "pages": [
          "features",
          "pricing"
        ]
      }
    ]
  },

  "footerSocials": {
    "website": "https://www.marsmind.co"
  },

  "feedback": {
    "thumbsRating": true,
    "suggestEdit": true,
    "raiseIssue": true
  },

  "search": {
    "prompt": "Search MarsMind documentation..."
  },

  "breadcrumbs": true,

  "api": {
    "playground": {
      "mode": "show"
    }
  },

  "modeToggle": {
    "default": "light",
    "isHidden": false
  }
}
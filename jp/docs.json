{
  "$schema": "https://mintlify.com/docs.json",
  
  "name": "MarsMindDocuments - 日本語",
  
  "theme": "mint",
  
  "colors": {
    "primary": "#0D47A1",
    "light": "#ECEFF1",
    "dark": "#212121"
  },

  "logo": {
    "light": "../logo-light.png",
    "dark": "../logo-dark.png"
  },
  
  "favicon": {
    "light": "../public/favicon.svg",
    "dark": "../public/favicon-dark.svg"
  },
    
  "navbar": {
    "primary": {
      "type": "button",
      "label": "ダッシュボード",
      "href": "https://lufitglobalselling.com:8888/#/index",
      "target": "_blank"
    }
  },

  "topbarLinks": [
    {
      "name": "English",
      "url": "/"
    }
  ],

  "navigation": [
    {
      "group": "はじめに",
      "pages": [
        "introduction",
        "quickstart"
      ]
    },
    {
      "group": "プロダクト",
      "pages": [
        "features",
        "pricing"
      ]
    }
  ],

  "footerSocials": {
    "website": "https://www.marsmind.co"
  },

  "feedback": {
    "thumbsRating": true,
    "suggestEdit": true,
    "raiseIssue": true
  },

  "search": {
    "prompt": "MarsMindドキュメントを検索..."
  },

  "breadcrumbs": true,

  "api": {
    "playground": {
      "mode": "show"
    }
  },

  "modeToggle": {
    "default": "light",
    "isHidden": false
  }
} 